@model CloudDesk.Models.ForgotPasswordViewModel

@{
    ViewData["Title"] = "Forgot Password";
}

<div class="container mt-5">

    <div class="row justify-content-center">

        <div class="col-md-5">

            <div class="card shadow p-4">

                <h2 class="text-center mb-4">
                    Forgot Password
                </h2>


                @if (ViewBag.Code != null)
                {
                    <div class="alert alert-info text-center">
                        Your Code:
                        <strong>@ViewBag.Code</strong>
                    </div>
                }


                <form asp-action="ForgotPassword"
                      asp-controller="Account"
                      method="post">

                    @Html.AntiForgeryToken()


                    <!-- USERNAME -->

                    <div class="mb-3">

                        <label asp-for="Username"
                               class="form-label">
                            Username
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               placeholder="Enter your username" />

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- NEW PASSWORD -->

                    <div class="mb-3">

                        <label asp-for="NewPassword"
                               class="form-label">
                            New Password
                        </label>

                        <input asp-for="NewPassword"
                               type="password"
                               class="form-control"
                               placeholder="Enter new password" />

                        <span asp-validation-for="NewPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CONFIRM PASSWORD -->

                    <div class="mb-3">

                        <label asp-for="ConfirmPassword"
                               class="form-label">
                            Confirm Password
                        </label>

                        <input asp-for="ConfirmPassword"
                               type="password"
                               class="form-control"
                               placeholder="Confirm new password" />

                        <span asp-validation-for="ConfirmPassword"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- CODE -->

                    <div class="mb-3">

                        <label asp-for="Code"
                               class="form-label">
                            Enter Code
                        </label>

                        <input asp-for="Code"
                               class="form-control"
                               placeholder="Enter 6 digit code"
                               maxlength="6"
                               autocomplete="off" />

                        <span asp-validation-for="Code"
                              class="text-danger">
                        </span>

                    </div>


                    <!-- ERRORS -->

                    <div asp-validation-summary="All"
                         class="text-danger mb-3">
                    </div>


                    <!-- RESET -->

                    <button type="submit"
                            class="btn btn-primary w-100">

                        Reset Password

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}